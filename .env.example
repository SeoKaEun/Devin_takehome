# --- required for live mode (not needed for SIMULATE=1) -------------------
DEVIN_API_KEY=cog_xxx            # https://app.devin.ai/settings/api-keys
GITHUB_TOKEN=github_pat_xxx      # fine-grained PAT: Issues+Contents+PRs RW on the fork
GITHUB_OWNER=your-github-login

# --- targets ---------------------------------------------------------------
FORK_REPO=devin_takehome_assignment
FORK_DEFAULT_BRANCH=master

# --- behavior knobs (defaults shown) ---------------------------------------
# TRIGGER_LABEL=devin-remediate
# POLL_INTERVAL_SEC=30
# SESSION_TIMEOUT_MIN=90
# MAX_ACU_PER_SESSION=10
# MAX_CONCURRENT_SESSIONS=2
# REVIEW_MODE=all              # all | off  (off = skip Gate-2 review sessions)
# AUTONOMY_MODE=balanced       # supervised | balanced | autopilot
#   supervised: no autonomous rework; every anomaly waits for a human
#   balanced:   1 rework round; docs/tests scope growth auto-accepted
#   autopilot:  2 rework rounds; review-approved PRs are auto-merged
